# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
.zed/
# one-off migration scripts stay local; the build's feed generator is tracked
scripts/*
!scripts/generate-feeds.ts
!scripts/generate-og.ts
content/posts.backup/
BROWSER_TEST_REPORT.md

# tanstack start / cloudflare build artifacts + local reference copy of old Next app
/dist
/.wrangler
/.reference-old
/.tanstack
/.output
